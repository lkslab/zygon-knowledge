schema_version: 2
id: brownfield
title: least-cost capacity expansion giving the existing fleet
what: >
  If the study's planning horizon lies before the likely retirement of the
  existing assets, their contribution to the energy mix has to be factored
  into the investment and dispatch decisions of additional capacity expansion.
  In contrast to `greenfield` studies, where existing assets are fully
  neglected.
  brownfield injects the existing fleet (with assets' retirement year)
  into the optimisation problem
  Only applies to the generation and conversion fleet, network assets are
  covered by a separate logic.
when_to_use:
  - "near-term optimisation"
  - "2025, 2030, 2035, 2040"
  - ""

models:
  - model: pypsa-eur
    version_anchor:
      ref: 849c8858d2536ccf8eed0c2e838d22a474a7ee5d
      date: "2026-07-31"
    status: draft                   # the eval flips this to `verified`
    baseline: null                  # or e.g. config.de1.yaml if the method
                                    # needs temporal resolution to show
    execution:
      - kind: config
        key: some.dot.path          # must exist in config.default.yaml
        value: CHANGE-ME
        note: why this key, in one line
      - kind: code
        where: "scripts/solve_network.py:extra_functionality"
        do: >
          Concrete imperative (<= 300 chars): what to add/change at this
          anchor. The agent will cite a recipe rung for the bundle change;
          this tells it WHAT to build there.
    invalidates:
      - prepare_sector_network
      - solve_sector_network
    budget:
      jobs: 4
      class: minutes
    success_metric:
      - name: constraint-binds
        needs: solved
        check: "n.global_constraints.mu.abs().max() > 0"
        expect: the added constraint exists and carries a shadow price

notes: >
  Optional (<= 800 chars): sharp caveats only — the known trap, the one
  interaction that bites. Literature and derivations: _qa/paper_methods/.
