+
+    def perfect_prenetwork_paths(w):
+        # first horizon enters via add_existing_baseyear's brownfield output,
+        # later horizons via their plain prepared prenetworks
+        first = str(config["scenario"]["planning_horizons"][0])
+        paths = []
+        for h in config["scenario"]["planning_horizons"]:
+            if str(h) == first:
+                paths.append(
+                    RESDIR
+                    + "prenetworks-brownfield/elec_s{simpl}_{clusters}_l{ll}_{opts}_{sopts}_"
+                    + str(h)
+                    + "_{discountrate}_{demand}_{h2export}export.nc"
+                )
+            else:
+                paths.append(
+                    RESDIR
+                    + "prenetworks/elec_s{simpl}_{clusters}_ec_l{ll}_{opts}_{sopts}_"
+                    + str(h)
+                    + "_{discountrate}_{demand}_{h2export}export.nc"
+                )
+        return paths
+
